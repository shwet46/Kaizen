# ============================================================
# Kaizen Python Voice & Intelligence Bot - Environment Configuration
# ============================================================

# Server Configuration
BOT_PORT=5001
PORT=5001
FLASK_ENV=production

# Database (MongoDB Atlas)
# Note: Ensure MongoDB Atlas Network Access has 0.0.0.0/0 allowed for Render
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ozeo411.mongodb.net/mern-app?retryWrites=true&w=majority

# AI / Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Google Cloud STT & TTS (Speech-to-Text & Text-to-Speech)
# Option A: Upload service account file to Render Secret Files (/etc/secrets/gcloud-service-account.json)
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/gcloud-service-account.json
# Option B: Or paste raw service account JSON string into this variable:
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
GOOGLE_CLOUD_PROJECT_ID=allknighters
