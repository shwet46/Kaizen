# ============================================================
# Kaizen Express Backend - Environment Configuration
# ============================================================

# Server Configuration
PORT=8000
NODE_ENV=production
# Frontend URL for CORS (allow comma-separated URLs or onrender.com URLs)
FRONTEND_URL=https://your-frontend.onrender.com

# Database (MongoDB Atlas)
# Note: Ensure MongoDB Atlas Network Access has 0.0.0.0/0 allowed for Render
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.ozeo411.mongodb.net/mern-app?retryWrites=true&w=majority

# AI / Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Google Cloud STT & TTS (Speech-to-Text & Text-to-Speech)
# Option A: Upload service account file to Render Secret Files (/etc/secrets/gcloud-service-account.json)
GOOGLE_APPLICATION_CREDENTIALS=/etc/secrets/gcloud-service-account.json
# Option B: Or paste raw service account JSON string into this variable:
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
GOOGLE_CLOUD_PROJECT_ID=allknighters

# Session / JWT Secret
JWT_SECRET=your_jwt_secret_change_in_production

# GitHub OAuth Integration (Optional)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=https://your-backend.onrender.com/api/oauth/github/callback
GITHUB_DEFAULT_REPO=owner/repo
GITHUB_TOKEN=your_github_personal_access_token

# Jira Integration (Optional)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEY=KAN
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token

# Neo4j Aura Graph Database (Optional)
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password
