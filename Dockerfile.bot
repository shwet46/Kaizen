# ==============================================================================
# Dockerfile for Kaizen Voice Bot Python Backend (Root Context)
# Used when Cloud Run Console Build Context is set to "/" (Root)
# ==============================================================================
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PORT=8080
ENV FLASK_ENV=production

# Install FFmpeg required by pydub for audio processing
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies from backend/bot
COPY backend/bot/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy bot application files
COPY backend/bot/ .

EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:${PORT}/health || exit 1

# Launch Flask app with Gunicorn
CMD exec gunicorn app:app --bind 0.0.0.0:${PORT} --workers 1 --threads 4 --timeout 120
